---
interface Props {
  level: 'beginner' | 'intermediate' | 'advanced';
}

const { level } = Astro.props;

const labels = {
  beginner: 'Beginner',
  intermediate: 'Intermediate',
  advanced: 'Advanced',
};
---

<span class:list={['badge', `badge--${level}`]}>
  {labels[level]}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-caption);
    font-weight: 600;
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-pill);
    line-height: 1.5;
  }

  .badge--beginner {
    background: var(--color-beginner-bg);
    color: var(--color-beginner);
  }

  .badge--intermediate {
    background: var(--color-intermediate-bg);
    color: var(--color-intermediate);
  }

  .badge--advanced {
    background: var(--color-advanced-bg);
    color: var(--color-advanced);
  }
</style>
