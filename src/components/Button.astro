---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  class: className,
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 600;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    cursor: pointer;
    border: 1.5px solid transparent;
    text-decoration: none;
    line-height: 1.5;
  }

  /* Sizes */
  .btn--sm { font-size: var(--text-body-sm); padding: 0.375rem 1rem; }
  .btn--md { font-size: var(--text-body); padding: 0.5rem 1.5rem; }
  .btn--lg { font-size: var(--text-body); padding: 0.75rem 2rem; }

  /* Primary */
  .btn--primary {
    background: var(--color-primary);
    color: #fff;
    border-color: var(--color-primary);
  }
  .btn--primary:hover {
    background: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
    color: #fff;
  }

  /* Secondary */
  .btn--secondary {
    background: var(--color-surface-card);
    color: var(--color-text);
    border-color: var(--color-border);
  }
  .btn--secondary:hover {
    background: var(--color-surface-alt);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* Ghost */
  .btn--ghost {
    background: transparent;
    color: var(--color-text-secondary);
    border-color: transparent;
  }
  .btn--ghost:hover {
    background: var(--color-surface-alt);
    color: var(--color-primary);
  }
</style>
