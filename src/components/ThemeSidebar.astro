---
const themes = [
  { id: 'ocean', label: 'Ocean', color: '#0066FF' },
  { id: 'forest', label: 'Forest', color: '#059669' },
  { id: 'sunset', label: 'Sunset', color: '#DC2626' },
  { id: 'berry', label: 'Berry', color: '#7C3AED' },
];

const fonts = [
  { id: 'sans', label: 'Inter (Sans)' },
  { id: 'serif', label: 'Merriweather (Serif)' },
  { id: 'mono', label: 'JetBrains Mono' },
];
---

<aside class="sidebar">
  <h2 class="sidebar__title">Theme Settings</h2>

  <!-- Color Scheme -->
  <section class="sidebar__section">
    <span class="sidebar__label">Color Scheme</span>
    <div class="scheme-toggle" data-scheme-toggle>
      <button class="scheme-toggle__btn scheme-toggle__btn--active" data-scheme="light">Light</button>
      <button class="scheme-toggle__btn" data-scheme="dark">Dark</button>
    </div>
  </section>

  <!-- Color Theme -->
  <section class="sidebar__section">
    <span class="sidebar__label">Color Theme</span>
    <div class="theme-grid" data-theme-grid>
      {themes.map((t) => (
        <button
          class={`theme-swatch ${t.id === 'ocean' ? 'theme-swatch--active' : ''}`}
          data-theme-value={t.id}
        >
          <span class="theme-swatch__dot" style={`background-color: ${t.color}`}></span>
          <span class="theme-swatch__name">{t.label}</span>
        </button>
      ))}
    </div>
  </section>

  <!-- Font Style -->
  <section class="sidebar__section">
    <span class="sidebar__label">Font Style</span>
    <div class="font-list" data-font-list>
      {fonts.map((f) => (
        <button
          class={`font-option ${f.id === 'sans' ? 'font-option--active' : ''}`}
          data-font-value={f.id}
        >
          {f.label}
        </button>
      ))}
    </div>
  </section>
</aside>

<script>
  function initThemeSidebar() {
    const html = document.documentElement;

    // Scheme toggle
    const schemeToggle = document.querySelector('[data-scheme-toggle]');
    schemeToggle?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-scheme]');
      if (!btn) return;
      const scheme = (btn as HTMLElement).dataset.scheme!;
      html.setAttribute('data-scheme', scheme);
      schemeToggle.querySelectorAll('.scheme-toggle__btn').forEach((b) =>
        b.classList.toggle('scheme-toggle__btn--active', b === btn)
      );
    });

    // Theme grid
    const themeGrid = document.querySelector('[data-theme-grid]');
    themeGrid?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-theme-value]');
      if (!btn) return;
      const theme = (btn as HTMLElement).dataset.themeValue!;
      html.setAttribute('data-theme', theme);
      themeGrid.querySelectorAll('.theme-swatch').forEach((b) =>
        b.classList.toggle('theme-swatch--active', b === btn)
      );
    });

    // Font list
    const fontList = document.querySelector('[data-font-list]');
    fontList?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-font-value]');
      if (!btn) return;
      const font = (btn as HTMLElement).dataset.fontValue!;
      html.setAttribute('data-font', font);
      fontList.querySelectorAll('.font-option').forEach((b) =>
        b.classList.toggle('font-option--active', b === btn)
      );
    });
  }

  initThemeSidebar();
  document.addEventListener('astro:after-swap', initThemeSidebar);
</script>

<style>
  .sidebar {
    width: 280px;
    min-width: 280px;
    height: 100vh;
    position: sticky;
    top: 0;
    padding: 24px 20px;
    background-color: var(--color-surface-alt);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 24px;
    overflow-y: auto;
    transition: background-color var(--transition), border-color var(--transition);
  }

  .sidebar__title {
    font-family: var(--font-family);
    font-size: 1.25rem;
    font-weight: var(--weight-bold);
    color: var(--color-text);
    transition: color var(--transition);
  }

  .sidebar__section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sidebar__label {
    font-family: var(--font-family);
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color var(--transition);
  }

  /* Scheme toggle */
  .scheme-toggle {
    display: flex;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: border-color var(--transition);
  }

  .scheme-toggle__btn {
    flex: 1;
    padding: 8px 12px;
    font-family: var(--font-family);
    font-size: 0.8125rem;
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all var(--transition);
  }

  .scheme-toggle__btn--active {
    background-color: var(--color-primary);
    color: var(--color-text-on-primary);
    font-weight: var(--weight-semibold);
  }

  /* Theme swatches */
  .theme-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .theme-swatch {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 8px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition);
  }

  .theme-swatch--active {
    border-color: var(--color-primary);
    border-width: 2px;
    padding: 7px; /* compensate */
  }

  .theme-swatch__dot {
    width: 24px;
    height: 24px;
    border-radius: 50%;
  }

  .theme-swatch__name {
    font-family: var(--font-family);
    font-size: 0.6875rem;
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    transition: color var(--transition);
  }

  .theme-swatch--active .theme-swatch__name {
    color: var(--color-primary);
    font-weight: var(--weight-semibold);
  }

  /* Font options */
  .font-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .font-option {
    display: flex;
    align-items: center;
    padding: 10px 12px;
    font-family: var(--font-family);
    font-size: 0.8125rem;
    font-weight: var(--weight-medium);
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition);
    text-align: left;
  }

  .font-option--active {
    background-color: var(--color-primary);
    color: var(--color-text-on-primary);
    border-color: var(--color-primary);
    font-weight: var(--weight-semibold);
  }
</style>
