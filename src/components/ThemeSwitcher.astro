---
const themes = [
  { id: 'ocean', label: 'Ocean', color: '#3b82f6' },
  { id: 'forest', label: 'Forest', color: '#10b981' },
  { id: 'sunset', label: 'Sunset', color: '#f97316' },
  { id: 'berry', label: 'Berry', color: '#8b5cf6' },
];
---

<div class="theme-switcher" data-theme-switcher>
  <h3 class="text-h3">Theme Palette</h3>
  <div class="theme-switcher__palettes">
    {themes.map(theme => (
      <button
        class="theme-swatch"
        data-set-theme={theme.id}
        style={`--swatch-color: ${theme.color}`}
        aria-label={`Switch to ${theme.label} theme`}
      >
        <span class="theme-swatch__dot"></span>
        <span class="theme-swatch__label">{theme.label}</span>
      </button>
    ))}
  </div>

  <h3 class="text-h3" style="margin-top: var(--space-5);">Color Scheme</h3>
  <div class="theme-switcher__schemes">
    <button class="scheme-btn" data-set-scheme="light">
      <span>&#9728;</span> Light
    </button>
    <button class="scheme-btn" data-set-scheme="dark">
      <span>&#9790;</span> Dark
    </button>
  </div>
</div>

<script>
  function initThemeSwitcher() {
    const html = document.documentElement;

    // Theme palette buttons
    document.querySelectorAll<HTMLElement>('[data-set-theme]').forEach(btn => {
      btn.addEventListener('click', () => {
        const theme = btn.dataset.setTheme!;
        html.setAttribute('data-theme', theme);
        localStorage.setItem('vibe-theme', theme);
      });
    });

    // Scheme buttons
    document.querySelectorAll<HTMLElement>('[data-set-scheme]').forEach(btn => {
      btn.addEventListener('click', () => {
        const scheme = btn.dataset.setScheme!;
        html.setAttribute('data-scheme', scheme);
        localStorage.setItem('vibe-scheme', scheme);
      });
    });
  }

  initThemeSwitcher();
  document.addEventListener('astro:after-swap', initThemeSwitcher);
</script>

<style>
  .theme-switcher {
    padding: var(--space-5);
    background: var(--color-surface-card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .theme-switcher__palettes {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .theme-swatch {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    cursor: pointer;
    transition: all var(--transition-fast);
    font-family: var(--font-body);
  }

  .theme-swatch:hover {
    border-color: var(--swatch-color);
  }

  .theme-swatch__dot {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--swatch-color);
  }

  .theme-swatch__label {
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .theme-switcher__schemes {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .scheme-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    transition: all var(--transition-fast);
  }

  .scheme-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
</style>
