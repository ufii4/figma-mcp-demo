---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Page Not Found" description="Oops — this page doesn't exist.">
  <section class="not-found">
    <div class="not-found__content">
      <span class="not-found__code">404</span>
      <h1 class="text-h1">Page not found</h1>
      <p class="not-found__desc">
        Looks like this page wandered off the canvas. Let's get you back to something beautiful.
      </p>
      <div class="not-found__actions">
        <Button href={`${base}/`} variant="primary" size="lg">Back to Home</Button>
        <Button href={`${base}/lessons`} variant="secondary" size="lg">Browse Lessons</Button>
      </div>
    </div>

    <!-- Decorative floating shapes -->
    <div class="not-found__shapes" aria-hidden="true">
      <div class="shape shape--1"></div>
      <div class="shape shape--2"></div>
      <div class="shape shape--3"></div>
      <div class="shape shape--4"></div>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-8) var(--space-4);
    overflow: hidden;
  }

  .not-found__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: 560px;
  }

  .not-found__code {
    font-size: clamp(6rem, 15vw, 12rem);
    font-weight: 800;
    line-height: 1;
    background: var(--gradient-hero);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    opacity: 0.9;
  }

  .not-found__desc {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 440px;
  }

  .not-found__actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  /* Decorative floating shapes */
  .not-found__shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .shape {
    position: absolute;
    border-radius: 50%;
    opacity: 0.08;
    animation: float 8s ease-in-out infinite;
  }

  .shape--1 {
    width: 300px;
    height: 300px;
    background: var(--color-primary);
    top: 10%;
    left: -5%;
    animation-delay: 0s;
  }

  .shape--2 {
    width: 200px;
    height: 200px;
    background: var(--color-accent);
    top: 20%;
    right: -3%;
    animation-delay: -2s;
  }

  .shape--3 {
    width: 150px;
    height: 150px;
    background: var(--color-secondary);
    bottom: 15%;
    left: 10%;
    animation-delay: -4s;
  }

  .shape--4 {
    width: 250px;
    height: 250px;
    background: var(--color-primary);
    bottom: 5%;
    right: 8%;
    animation-delay: -6s;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-20px) scale(1.05); }
  }

  @media (max-width: 768px) {
    .not-found__actions {
      flex-direction: column;
      width: 100%;
    }

    .shape--1, .shape--4 { display: none; }
  }
</style>
